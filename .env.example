NODE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_CLIENT_NAME=KOG

# Use only for local review. Production refuses demo authentication.
NUXT_DEMO_MODE=true
DEMO_USER_EMAIL=client@example.com
DEMO_USER_PASSWORD=change-me-locally

# MySQL 8 connection string
DATABASE_URL=mysql://user:password@127.0.0.1:3306/tcz_kog
SESSION_SECRET=generate-at-least-32-random-bytes
SYNC_SECRET=generate-a-separate-random-secret

# Google service account. Share the lead sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:ZZ
